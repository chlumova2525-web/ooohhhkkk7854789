{
  "name": "stavebni-denik",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence rekonstrukce domu — rozpočet, faktury, dotace, pracovní deník",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --jsx=automatic --loader:.jsx=jsx --define:process.env.NODE_ENV=\"\\\"production\\\"\" --outfile=docs/app.js",
    "watch": "npm run build -- --watch",
    "start": "npx serve docs",
    "test": "node tests/run.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "jsdom": "^30.1.0"
  }
}
